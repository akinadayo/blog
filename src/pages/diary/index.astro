---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PostCard } from '../../components/PostCard';
const posts = (await getCollection('diary', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const site = Astro.site ?? new URL('https://neu-dev.net');
const pageUrl = new URL('/diary/', site).href;
const description = '身近な疑問をデータや計算で掘り下げた分析と、個人開発者NeUの日々の発見をまとめた記事一覧。';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      url: pageUrl,
      name: 'NeULOG 日記・分析記事一覧',
      description,
      inLanguage: 'ja',
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: posts.map((post, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: post.data.title,
          url: new URL(`/diary/${post.data.permalink || post.slug}/`, site).href,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', site).href },
        { '@type': 'ListItem', position: 2, name: '日記・分析記事', item: pageUrl },
      ],
    },
  ],
};
---
<BaseLayout title="日記・分析記事一覧" currentPage="diary" description={description} structuredData={structuredData}>
  <section class="archive-hero archive-hero--diary"><span>コレクション / 日記</span><h1>日々の<br />寄り道</h1><p>日々の出来事と、何気ない発見。</p></section>
  <section class="logs-section logs-section--archive">
    <div class="section-kicker"><span>DIARY ARCHIVE / {String(posts.length).padStart(3, '0')}件</span><h2>日記・分析記事一覧</h2></div>
    <div class="log-filters"><a href="/">すべて</a><a href="/tech/">技術</a><a class="is-active" href="/diary/">日記 <sup>{posts.length}</sup></a></div>
    <div class="logs-grid">{posts.map((post, index) => <PostCard client:visible title={post.data.title} excerpt={post.data.description || (post.data.mood ? `今日の気分: ${post.data.mood}` : '')} date={post.data.pubDate.toLocaleDateString('ja-JP')} category="diary" slug={post.data.permalink || post.slug} reactionSlug={post.slug} collection="diary" coverImage={post.data.coverImage} index={index} featured={index === 0} />)}</div>
  </section>
</BaseLayout>
