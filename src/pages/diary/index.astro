---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PostCard } from '../../components/PostCard';
const posts = (await getCollection('diary', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="DIARY LOG" currentPage="post" description="NeUの日々の寄り道ログ一覧">
  <section class="archive-hero archive-hero--diary"><span>COLLECTION / DIARY</span><h1>DAILY<br />SIDE QUESTS</h1><p>日々の出来事と、何気ない発見。</p></section>
  <section class="logs-section logs-section--archive">
    <div class="log-filters"><a href="/">ALL</a><a href="/tech/">TECH</a><a class="is-active" href="/diary/">DIARY <sup>{posts.length}</sup></a></div>
    <div class="logs-grid">{posts.map((post, index) => <PostCard client:visible title={post.data.title} excerpt={post.data.mood ? `今日の気分: ${post.data.mood}` : ''} date={post.data.pubDate.toLocaleDateString('ja-JP')} category="diary" slug={post.slug} collection="diary" coverImage={post.data.coverImage} index={index} featured={index === 0} />)}</div>
  </section>
</BaseLayout>
