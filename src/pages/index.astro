---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PostCard } from '../components/PostCard';
import { RetroGameBackground } from '../components/RetroGameBackground';
import { GameLauncher } from '../components/GameLauncher';
import { HeroConsole } from '../components/HeroConsole';
import { Leaderboard } from '../components/Leaderboard';
import { VisitorTicket } from '../components/VisitorTicket';

const techPosts = await getCollection('tech', ({ data }) => !data.draft);
const diaryPosts = await getCollection('diary', ({ data }) => !data.draft);
const allPosts = [
  ...techPosts.map(post => ({ ...post, category: 'tech' as const, publicSlug: post.slug, reactionSlug: post.slug, description: post.data.description || '', coverImage: post.data.coverImage })),
  ...diaryPosts.map(post => ({ ...post, category: 'diary' as const, publicSlug: post.data.permalink || post.slug, reactionSlug: post.slug, description: post.data.mood ? `今日の気分: ${post.data.mood}` : '', coverImage: post.data.coverImage })),
].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="HOME" currentPage="home" description="iOSアプリやWebツールを個人開発。生成AIを相棒にした開発の試行錯誤と、身近な疑問をデータや計算で掘り下げた記録を書くNeUのブログ。">
  <section id="top" class="home-hero">
    <div class="home-hero__game" aria-hidden="true"><RetroGameBackground client:only="react" /></div>
    <div class="home-hero__veil"></div>
    <div class="hero-orbit hero-orbit--one"></div><div class="hero-orbit hero-orbit--two"></div>
    <div class="home-hero__inner">
      <div class="hero-copy">
        <div class="status-ribbon"><i></i> PLAYER 01 / CREATING</div>
        <h1><span>MAKE.</span><span>BREAK.</span><em>WRITE!</em></h1>
        <p>iOSアプリやWebツールをつくり、生成AIを相棒に試行錯誤する。<br />つくる途中の発見と、身近な疑問を掘り下げるNeUのログです。</p>
        <VisitorTicket client:visible />
        <div class="hero-actions">
          <a href="#latest" class="pixel-button pixel-button--purple hero-latest">最新の記事を読む ↘</a>
          <button class="pixel-button pixel-button--ghost" data-side-quest>⚄ おまけを引く</button>
        </div>
        <div class="side-quest-message" data-side-quest-message aria-live="polite"></div>
      </div>
      <div class="hero-console-stack">
        <HeroConsole client:visible />
        <GameLauncher client:only="react" />
      </div>
    </div>
    <a class="scroll-cue" href="#latest"><span>記事へ</span><i></i></a>
  </section>

  <div class="skill-marquee" aria-label="Topics">
    <div><span>iOS / SWIFTUI ✦</span><span>AI-ASSISTED DEV ✦</span><span>INDIE APP DEV ✦</span><span>ASTRO / WEB ✦</span><span>ELECTRON ✦</span><span>DATA / ANALYSIS ✦</span><span>iOS / SWIFTUI ✦</span><span>AI-ASSISTED DEV ✦</span></div>
  </div>

  <section id="latest" class="logs-section">
    <div class="section-kicker"><span>実験ログ / {String(allPosts.length).padStart(3, '0')}件</span><b>最新の記事</b></div>
    <div class="log-filters">
      <a class="is-active" href="/">すべて <sup>{allPosts.length}</sup></a>
      <a href="/tech/">技術 <sup>{techPosts.length}</sup></a>
      <a href="/diary/">日記 <sup>{diaryPosts.length}</sup></a>
    </div>
    <div class="logs-grid">
      {allPosts.map((post, index) => (
        <PostCard client:visible title={post.data.title} excerpt={post.description} date={post.data.pubDate.toLocaleDateString('ja-JP')} category={post.category} slug={post.publicSlug} reactionSlug={post.reactionSlug} collection={post.category} coverImage={post.coverImage} index={index} featured={index === 0} />
      ))}
    </div>
    {allPosts.length === 0 && <div class="empty-state"><b>まだ記事がありません</b><span>最初の記事を準備中です。</span></div>}
  </section>

  <Leaderboard client:visible />

  <script>
    const hero = document.querySelector('.home-hero');
    const parallax = document.querySelector('[data-parallax]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (hero && parallax && !reduced) {
      hero.addEventListener('pointermove', (event) => {
        const rect = hero.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - .5;
        const y = (event.clientY - rect.top) / rect.height - .5;
        parallax.style.setProperty('--parallax-x', `${x * 18}px`);
        parallax.style.setProperty('--parallax-y', `${y * 14}px`);
      }, { passive: true });
    }
    const quests = ['今日は知らないAPIを1つ触る。', '失敗したコードを1つメモに残す。', '眠っているアイデアを10分だけ動くものにする。', 'READMEを未来の自分向けに1行直す。'];
    document.querySelector('[data-side-quest]')?.addEventListener('click', () => {
      const target = document.querySelector('[data-side-quest-message]');
      if (target) target.textContent = `今日のおまけ：${quests[Math.floor(Math.random() * quests.length)]}`;
    });
  </script>
</BaseLayout>
