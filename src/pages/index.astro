---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PostCard } from '../components/PostCard';
import { RetroGameBackground } from '../components/RetroGameBackground';
import { GameLauncher } from '../components/GameLauncher';
import { HeroConsole } from '../components/HeroConsole';
import { Leaderboard } from '../components/Leaderboard';
import { VisitorTicket } from '../components/VisitorTicket';

const techPosts = await getCollection('tech', ({ data }) => !data.draft);
const diaryPosts = await getCollection('diary', ({ data }) => !data.draft);
const allPosts = [
  ...techPosts.map(post => ({ ...post, category: 'tech' as const, description: post.data.description || '', coverImage: post.data.coverImage })),
  ...diaryPosts.map(post => ({ ...post, category: 'diary' as const, description: post.data.mood ? `今日の気分: ${post.data.mood}` : '', coverImage: post.data.coverImage })),
].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="HOME" currentPage="home" description="技術を試して、たまに壊して、気づきを書く。エンジニアNeUの実験ノート。">
  <section id="top" class="home-hero">
    <div class="home-hero__game" aria-hidden="true"><RetroGameBackground client:only="react" /></div>
    <div class="home-hero__veil"></div>
    <div class="hero-orbit hero-orbit--one"></div><div class="hero-orbit hero-orbit--two"></div>
    <div class="home-hero__inner">
      <div class="hero-copy">
        <div class="status-ribbon"><i></i> PLAYER 01 IS WRITING</div>
        <h1><span>MAKE.</span><span>BREAK.</span><em>WRITE!</em></h1>
        <p>技術を試して、たまに壊して、気づきを書く。<br />エンジニア NeU の実験ノート兼、寄り道だらけの冒険ログです。</p>
        <VisitorTicket client:visible />
        <div class="hero-actions">
          <a href="#latest" class="pixel-button pixel-button--purple hero-latest">READ LATEST ↘</a>
          <button class="pixel-button pixel-button--ghost" data-side-quest>⚄ SIDE QUEST</button>
        </div>
        <div class="side-quest-message" data-side-quest-message aria-live="polite"></div>
      </div>
      <div class="hero-console-stack">
        <HeroConsole client:visible />
        <GameLauncher client:only="react" />
      </div>
    </div>
    <a class="scroll-cue" href="#latest"><span>SCROLL</span><i></i></a>
  </section>

  <div class="skill-marquee" aria-label="Topics">
    <div><span>MODELING ✦</span><span>FAILED EXPERIMENTS ✦</span><span>REACT NATIVE ✦</span><span>AI TOOLS ✦</span><span>ELECTRONICS ✦</span><span>MODELING ✦</span><span>FAILED EXPERIMENTS ✦</span></div>
  </div>

  <section id="latest" class="logs-section">
    <div class="section-kicker"><span>QUEST LOG / {String(allPosts.length).padStart(3, '0')} ENTRIES</span><b>LATEST EXPERIMENTS</b></div>
    <div class="log-filters">
      <a class="is-active" href="/">ALL <sup>{allPosts.length}</sup></a>
      <a href="/tech/">TECH <sup>{techPosts.length}</sup></a>
      <a href="/diary/">DIARY <sup>{diaryPosts.length}</sup></a>
    </div>
    <div class="logs-grid">
      {allPosts.map((post, index) => (
        <PostCard client:visible title={post.data.title} excerpt={post.description} date={post.data.pubDate.toLocaleDateString('ja-JP')} category={post.category} slug={post.slug} collection={post.category} coverImage={post.coverImage} index={index} featured={index === 0} />
      ))}
    </div>
    {allPosts.length === 0 && <div class="empty-state"><b>NO QUESTS YET</b><span>最初の記事を準備中です。</span></div>}
  </section>

  <Leaderboard client:visible />

  <script>
    const hero = document.querySelector('.home-hero');
    const parallax = document.querySelector('[data-parallax]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (hero && parallax && !reduced) {
      hero.addEventListener('pointermove', (event) => {
        const rect = hero.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - .5;
        const y = (event.clientY - rect.top) / rect.height - .5;
        parallax.style.setProperty('--parallax-x', `${x * 18}px`);
        parallax.style.setProperty('--parallax-y', `${y * 14}px`);
      }, { passive: true });
    }
    const quests = ['今日は知らないAPIを1つ触る。', '失敗したコードを1つメモに残す。', '机の上の積み回路を10分だけ動かす。', 'READMEを未来の自分向けに1行直す。'];
    document.querySelector('[data-side-quest]')?.addEventListener('click', () => {
      const target = document.querySelector('[data-side-quest-message]');
      if (target) target.textContent = `SIDE QUEST: ${quests[Math.floor(Math.random() * quests.length)]}`;
    });
  </script>
</BaseLayout>
